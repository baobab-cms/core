{
  "name": "acme/notifier",
  "title": "Notifier fixture",
  "description": "Fixture pour tester la validation des notifications déclarées (NotificationValidatorTest).",
  "version": "1.0.0",
  "type": "module",
  "provider": "Acme\\Notifier\\Providers\\NotifierServiceProvider",
  "mails": [
    {
      "key": "acme.notifier.pending",
      "description": "Envoyé quand un élément attend une action.",
      "variables": {
        "item.name": "Nom de l'élément"
      },
