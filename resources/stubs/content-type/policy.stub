<?php

declare(strict_types=1);

namespace {{ namespace }}\Policies;

use {{ namespace }}\Models\{{ key }};
use Baobab\Users\Models\User;

/**
 * Own/any (spec 05 §3.2) : {{ var }}.update_any/{{ var }}.delete_any/{{ var }}.publish_any
 * autorisent sur n'importe quelle ligne ; les variantes sans _any exigent en
 * plus author_id === $user->id. Éditable à la main sans risque : une
 * régénération respecte l'anti-écrasement par checksum.
 */
final class {{ key }}Policy
{
    public function viewAny(User $user): bool
    {
        return $user->can('{{ permission_prefix }}.view');
    }

    public function view(User $user): bool
    {
        return $user->can('{{ permission_prefix }}.view');
    }

    public function create(User $user): bool
    {
        return $user->can('{{ permission_prefix }}.create');
    }

    public function update(User $user, {{ key }} ${{ var }}): bool
    {
        return $user->can('{{ permission_prefix }}.update_any')
            || ($user->can('{{ permission_prefix }}.update') && ${{ var }}->author_id === $user->id);
    }

    public function delete(User $user, {{ key }} ${{ var }}): bool
    {
        return $user->can('{{ permission_prefix }}.delete_any')
            || ($user->can('{{ permission_prefix }}.delete') && ${{ var }}->author_id === $user->id);
    }

    public function publish(User $user, {{ key }} ${{ var }}): bool
    {
        return $user->can('{{ permission_prefix }}.publish_any')
            || ($user->can('{{ permission_prefix }}.publish') && ${{ var }}->author_id === $user->id);
    }

    public function restore(User $user, {{ key }} ${{ var }}): bool
    {
        return $this->delete($user, ${{ var }});
    }

    /**
     * Purge définitive (spec 09 §8) — permission globale dédiée, pas own/any
     * : plus stricte que la simple mise à la corbeille, y compris pour le
     * propriétaire.
     */
    public function forceDelete(User $user): bool
    {
        return $user->can('baobab.trash.purge');
    }
}
