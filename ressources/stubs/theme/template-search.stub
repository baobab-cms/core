    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
        <h1 class="font-display text-3xl font-semibold tracking-tight text-foreground">Recherche</h1>

        <form method="GET" action="{{ url()->current() }}" class="mt-6 flex gap-3">
            <input type="search" name="q" value="{{ $query }}" class="flex-1 rounded-md border border-border bg-surface px-3 py-2 text-foreground" />
            <button type="submit" class="rounded-md bg-primary px-4 py-2 font-medium text-white">Rechercher</button>
