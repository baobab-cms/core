<?php

declare(strict_types=1);

namespace {{ namespace }}\Http\Controllers\Api;

use {{ namespace }}\Actions\Delete{{ key }};
use {{ namespace }}\Actions\Save{{ key }};
use {{ namespace }}\Http\Requests\{{ key }}Request;
use {{ namespace }}\Http\Resources\{{ key }}Resource;
use {{ namespace }}\Models\{{ key }};
use Baobab\Api\Support\ApiActor;
use Baobab\Users\Models\User;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Resources\Json\AnonymousResourceCollection;
use Illuminate\Routing\Controller;

/**
 * Adaptateur mince, exactement comme le contrôleur d'admin, et appelant les
 * **mêmes** Actions : une règle métier ajoutée à `Save{{ key }}` vaut pour les
 * deux surfaces sans être écrite deux fois.
 */
final class {{ key }}Controller extends Controller
{
    public function index(): AnonymousResourceCollection
    {
        abort_unless($this->actor()->can('viewAny', {{ key }}::class), 403);

        return {{ key }}Resource::collection({{ key }}::query()->latest()->paginate(20));
    }

    public function show({{ key }} ${{ var }}): {{ key }}Resource
    {
        abort_unless($this->actor()->can('view', ${{ var }}), 403);

        return new {{ key }}Resource(${{ var }});
    }

    public function store({{ key }}Request $request): JsonResponse
    {
        abort_unless($this->actor()->can('create', {{ key }}::class), 403);

        ${{ var }} = app(Save{{ key }}::class)($request->validated());

        return (new {{ key }}Resource(${{ var }}))->response()->setStatusCode(201);
    }

    public function update({{ key }}Request $request, {{ key }} ${{ var }}): {{ key }}Resource
    {
        abort_unless($this->actor()->can('update', ${{ var }}), 403);

        return new {{ key }}Resource(app(Save{{ key }}::class)($request->validated(), ${{ var }}));
    }

    public function destroy({{ key }} ${{ var }}): JsonResponse
    {
        abort_unless($this->actor()->can('delete', ${{ var }}), 403);

        app(Delete{{ key }}::class)(${{ var }});

        return response()->json(null, 204);
    }

    private function actor(): User
    {
        $actor = app(ApiActor::class)();

        abort_unless($actor instanceof User, 401);

        return $actor;
    }
}
